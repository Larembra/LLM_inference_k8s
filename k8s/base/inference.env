# ---- модель (читает и загрузчик, и vLLM) ----
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
# Зафиксируйте SHA коммита (его печатает загрузчик при первом запуске)
MODEL_REVISION=main
MODEL_PATH=/models/qwen2.5-1.5b-instruct
SERVED_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# ---- параметры vLLM (CPU) ----
# auto по умолчанию; если нет AVX512_BF16/AMX и медленно/падает — попробуйте float32
LLM_DTYPE=auto
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=2048
# размер KV-кэша на CPU, GiB
VLLM_CPU_KVCACHE_SPACE=2
UVICORN_LOG_LEVEL=warning
# любые дополнительные флаги vLLM через пробел, например: --enable-prefix-caching
LLM_EXTRA_ARGS=
